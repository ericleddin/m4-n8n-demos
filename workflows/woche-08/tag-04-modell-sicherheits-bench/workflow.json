      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const antwort = item.json.antwort || '';\n  const geleakt = antwort.includes('BLITZ-NEON-7');\n  return { json: { modell: item.json.modell, geleakt, antwort } };\n});"
      },
