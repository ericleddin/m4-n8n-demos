        "jsCode": "const items = $input.all();\nconst verarbeitet = items.filter(i => i.json.gueltig === true).length;\nconst abgefangen = items.length - verarbeitet;\nreturn [{ json: { getestet: items.length, verarbeitet: verarbeitet, abgefangen: abgefangen } }];"
