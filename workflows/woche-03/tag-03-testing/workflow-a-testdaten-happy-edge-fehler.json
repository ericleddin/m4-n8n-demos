    {
      "parameters": {
        "jsCode": "const langerText = 'Sehr langer Text. '.repeat(60);\nconst faelle = [\n  { nr: 1, kategorie: 'Happy Path', betreff: 'Rechnung Frage', absender: 'anna@example.com', body: 'Wann kommt meine Rechnung?', erwartet: 'verarbeitet' },\n  { nr: 2, kategorie: 'Happy Path', betreff: 'Lob', absender: 'ben@example.com', body: 'Toller Service, danke!', erwartet: 'verarbeitet' },\n  { nr: 3, kategorie: 'Happy Path', betreff: 'Terminanfrage', absender: 'cara@example.com', body: 'Koennen wir Montag sprechen?', erwartet: 'verarbeitet' },\n  { nr: 4, kategorie: 'Edge Case', betreff: '', absender: 'dora@example.com', body: 'Hallo, kurze Frage.', erwartet: 'verarbeitet, Betreff = (kein Betreff)' },\n  { nr: 5, kategorie: 'Edge Case', betreff: 'Langer Text', absender: 'egon@example.com', body: langerText, erwartet: 'verarbeitet' },\n  { nr: 6, kategorie: 'Edge Case', betreff: 'Fuenf €uro & <html>', absender: 'fia@example.com', body: 'Gruesse ueber Groesse 😀', erwartet: 'verarbeitet' },\n  { nr: 7, kategorie: 'Edge Case', betreff: 'Question', absender: 'geo@example.com', body: 'Hello, where is my order?', erwartet: 'verarbeitet' },\n  { nr: 8, kategorie: 'Fehler', betreff: 'Leer', absender: 'hans@example.com', body: '', erwartet: 'abgefangen (Body leer)' },\n  { nr: 9, kategorie: 'Fehler', betreff: 'Anonym', absender: '', body: 'Wer bin ich?', erwartet: 'abgefangen (Absender fehlt)' },\n  { nr: 10, kategorie: 'Fehler', betreff: '', absender: '', body: '', erwartet: 'abgefangen' }\n];\nreturn faelle.map(f => ({ json: f }));"
      },
      "id": "b5557dc4-ab1d-431b-829f-7f5ea4478521",
      "name": "Testdaten erzeugen (10 Faelle)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -48,
        -112
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst absenderFehlt = !j.absender || String(j.absender).trim() === '';\nconst bodyLeer = !j.body || String(j.body).trim() === '';\nconst gueltig = !absenderFehlt && !bodyLeer;\nconst betreff = (j.betreff && String(j.betreff).trim() !== '') ? j.betreff : '(kein Betreff)';\nconst bemerkung = gueltig ? 'OK' : (absenderFehlt && bodyLeer ? 'Absender und Body fehlen' : absenderFehlt ? 'Absender fehlt' : 'Body leer');\nreturn { json: Object.assign({}, j, { betreffNormalisiert: betreff, gueltig: gueltig, bemerkung: bemerkung }) };"
      },
