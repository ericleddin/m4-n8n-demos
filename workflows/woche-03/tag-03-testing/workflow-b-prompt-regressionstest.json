        "jsCode": "return [\n  { json: { nr: 1, frage: 'Was ist ein Webhook?', erwartet: 'Automatische HTTP-Benachrichtigung bei einem Ereignis; der Begriff Webhook bleibt englisch.' } },\n  { json: { nr: 2, frage: 'Wofuer steht die Abkuerzung API?', erwartet: 'Application Programming Interface - Schnittstelle zwischen Programmen.' } },\n  { json: { nr: 3, frage: 'Was bedeutet HTTP-Status 404?', erwartet: 'Die angeforderte Ressource wurde nicht gefunden.' } },\n  { json: { nr: 4, frage: 'Unterschied zwischen GET und POST?', erwartet: 'GET liest Daten, POST sendet bzw. erstellt Daten.' } },\n  { json: { nr: 5, frage: 'Was ist ein Rate Limit?', erwartet: 'Begrenzung der Anzahl erlaubter Anfragen pro Zeitraum.' } }\n];"
