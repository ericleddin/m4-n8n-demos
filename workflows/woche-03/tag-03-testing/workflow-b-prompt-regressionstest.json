      "parameters": {
        "jsCode": "const items = $input.all();\nconst pass = items.filter(i => String(i.json.urteil || '').toUpperCase().startsWith('PASS')).length;\nreturn [{ json: { gesamt: items.length, bestanden: pass, durchgefallen: items.length - pass } }];"
