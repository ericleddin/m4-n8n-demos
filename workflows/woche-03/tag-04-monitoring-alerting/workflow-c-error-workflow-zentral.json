            {
              "id": "htmlBody",
              "name": "htmlBody",
              "value": "=<h2>Ein Workflow ist fehlgeschlagen</h2><p><strong>Workflow:</strong> {{ $json.workflow.name }}</p><p><strong>Fehler:</strong> {{ $json.execution.error.message }}</p><p><strong>Node:</strong> {{ $json.execution.lastNodeExecuted }}</p><p><strong>Zeitstempel:</strong> {{ $now.toFormat(\"dd.MM.yyyy HH:mm:ss\") }}</p><p><a href=\"{{ $json.execution.url }}\">Zum fehlgeschlagenen Lauf</a></p>",
