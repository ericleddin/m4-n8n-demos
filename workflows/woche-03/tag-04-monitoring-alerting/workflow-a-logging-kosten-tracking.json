    {
      "parameters": {
        "jsCode": "const start = $('Eingabe & Start-Zeit').first().json.startTime;\nconst durationMs = Date.now() - new Date(start).getTime();\n\nconst resp = $input.first().json;\nconst usage = resp.usage || {};\nconst promptTokens = usage.prompt_tokens || 0;\nconst completionTokens = usage.completion_tokens || 0;\nconst totalTokens = usage.total_tokens || (promptTokens + completionTokens);\n\n// gpt-4o-mini Preise (USD pro 1 Token)\nconst PRICE_INPUT = 0.15 / 1000000;\nconst PRICE_OUTPUT = 0.60 / 1000000;\nconst costUsd = promptTokens * PRICE_INPUT + completionTokens * PRICE_OUTPUT;\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    node: 'LLM Call (OpenRouter)',\n    status: 'success',\n    duration_ms: durationMs,\n    prompt_tokens: promptTokens,\n    completion_tokens: completionTokens,\n    total_tokens: totalTokens,\n    cost_usd: Number(costUsd.toFixed(6))\n  }\n}];"
      },
      "id": "6ee3b4f0-9c02-4f44-a752-eaa7365318fe",
