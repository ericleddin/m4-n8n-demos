        "mode": "runOnceForEachItem",
        "jsCode": "let t = $json.text || '';\nt = t.replace(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/g, '[EMAIL]');\nconst name = $json.name || '';\nif (name) { t = t.split(name).join('[NAME]'); }\nreturn { json: { anonymizedText: t } };"
