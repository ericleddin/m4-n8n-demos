      "id": "d0044e6b-a3e5-494e-a4cd-c05303cf6065",
      "name": "Tavily: Claim recherchieren",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        2224,
        304
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const search = $input.all();\nconst claims = $('Claims aufteilen').all();\nlet erfolgreiche = 0;\nconst recherche = search.map((s, i) => {\n  const fehlgeschlagen = !!s.json.error || (!s.json.results && !s.json.answer);\n  if (!fehlgeschlagen) erfolgreiche++;\n  return {\n    claim: claims[i]?.json.claim ?? '',\n    tavily_answer: fehlgeschlagen ? null : (s.json.answer || null),\n    quellen: fehlgeschlagen ? [] : (s.json.results || []).slice(0, 3).map(r => ({ titel: r.title, url: r.url, auszug: (r.content || '').slice(0, 300) }))\n  };\n});\nreturn [{ json: { zusammenfassung: claims[0]?.json.zusammenfassung || '', recherche, verifikation_aktiv: erfolgreiche > 0 } }];"
      },
      "id": "1d9ae112-1294-4fd5-bde1-348967b7761b",
      "name": "Recherche bündeln",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2448,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "openai/gpt-4o-mini"
            },
            {
              "name": "response_format",
              "value": "={{ { \"type\": \"json_object\" } }}"
            },
            {
              "name": "messages",
              "value": "={{ [ { \"role\": \"system\", \"content\": \"Du bist ein nüchterner Analyst für AI-News. Du bekommst einen Originaltext und Web-Rechercheergebnisse. Erstelle eine Einordnung als JSON, exakt in diesem Format: {\\\"zusammenfassung\\\": \\\"1-2 Sätze\\\", \\\"claims\\\": [{\\\"behauptung\\\": \\\"...\\\", \\\"bewertung\\\": \\\"belegt|teilweise belegt|spekulation|nicht prüfbar\\\", \\\"begruendung\\\": \\\"...\\\", \\\"quellen\\\": [\\\"url\\\"]}], \\\"hype_score\\\": 0-10, \\\"hype_score_begruendung\\\": \\\"...\\\", \\\"takeaways\\\": [\\\"...\\\"]}. Die takeaways richten sich an Lernende im AI-Bereich (Karrierewechsler): Was bedeutet das konkret für sie, ohne Panik, ohne Verharmlosung. Antworte auf Deutsch. Stütze Bewertungen ausschließlich auf die Rechercheergebnisse. Wenn zu einem Claim keine Rechercheergebnisse vorliegen, bewerte ihn als nicht prüfbar.\" }, { \"role\": \"user\", \"content\": \"Originaltext:\\n\" + $(\"Analyse-Input\").first().json.input + \"\\n\\nRechercheergebnisse:\\n\" + JSON.stringify($json.recherche) } ] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b3c72078-b721-4290-b4f2-c0130b2c16eb",
      "name": "LLM 2: Einordnung erstellen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        2672,
        304
      ],
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const content = $input.first().json.choices?.[0]?.message?.content ?? '';\nlet result;\ntry {\n  result = JSON.parse(content);\n} catch (e) {\n  throw new Error('LLM-Antwort war kein valides JSON: ' + content.slice(0, 200));\n}\nresult.verifikation_aktiv = $('Recherche bündeln').first().json.verifikation_aktiv;\nresult.analysiert_am = new Date().toISOString();\nresult.quelle_url = $('Analyse-Input').first().json.quelle_url || null;\nreturn [{ json: result }];"
      },
