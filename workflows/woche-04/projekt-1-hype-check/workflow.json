      "parameters": {
        "jsCode": "const r = $input.first().json;\nfunction esc(s) { return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }\nconst claimsHtml = (r.claims || []).map(function(c) {\n  const quellen = (c.quellen || []).map(function(u) { return '<a href=\"' + esc(u) + '\">' + esc(u) + '</a>'; }).join('<br>');\n  return '<li style=\"margin-bottom:12px\"><b>' + esc(c.behauptung) + '</b> &ndash; <i>' + esc(c.bewertung) + '</i><br>' + esc(c.begruendung) + (quellen ? '<br><small>' + quellen + '</small>' : '') + '</li>';\n}).join('');\nconst takeawaysHtml = (r.takeaways || []).map(function(t) { return '<li>' + esc(t) + '</li>'; }).join('');\nconst html = '<div style=\"font-family:sans-serif;max-width:600px\">' +\n  '<h2>Hype-Check Ergebnis</h2>' +\n  '<p>' + esc(r.zusammenfassung) + '</p>' +\n  '<p><b>Hype-Score: ' + esc(r.hype_score) + ' / 10</b><br>' + esc(r.hype_score_begruendung) + '</p>' +\n  '<h3>Behauptungen</h3><ul>' + claimsHtml + '</ul>' +\n  '<h3>Takeaways</h3><ul>' + takeawaysHtml + '</ul>' +\n  (r.verifikation_aktiv === false ? '<p><i>Hinweis: Die Web-Verifikation war nicht verfügbar.</i></p>' : '') +\n  (r.quelle_url ? '<p><small>Quelle: ' + esc(r.quelle_url) + '</small></p>' : '') +\n  '<hr><p><small>Hype-Check ist ein Lernprojekt (M4, Projekt 1) und kein abschließender Faktencheck.</small></p>' +\n  '</div>';\nreturn [{ json: { betreff: 'Hype-Check Ergebnis: Score ' + (r.hype_score ?? '?') + '/10', html: html } }];"
      },
