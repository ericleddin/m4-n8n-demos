      "id": "72f8dbdb-cf8a-4b92-b23c-ccba10d93968",
      "name": "LLM 1: Claims extrahieren",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1792,
        304
      ],
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst content = raw.choices?.[0]?.message?.content ?? '';\nlet parsed;\ntry {\n  parsed = JSON.parse(content);\n} catch (e) {\n  throw new Error('LLM-Antwort war kein valides JSON: ' + content.slice(0, 200));\n}\nconst claims = (parsed.claims || []).slice(0, 3);\nif (claims.length === 0) {\n  throw new Error('Keine prüfbaren Behauptungen im Text gefunden.');\n}\nreturn claims.map((c, i) => ({ json: { claim: c, claimIndex: i, totalClaims: claims.length, zusammenfassung: parsed.zusammenfassung || '' } }));"
      },
      "id": "a85d3e84-a3e6-4ebe-9377-466efaf73d08",
      "name": "Claims aufteilen",
      "type": "n8n-nodes-base.code",
