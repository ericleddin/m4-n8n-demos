            {
              "name": "messages",
              "value": "={{ [ { \"role\": \"system\", \"content\": \"Du extrahierst überprüfbare Behauptungen aus AI-News und Social-Media-Texten. Antworte ausschließlich mit JSON in diesem Format: {\\\"zusammenfassung\\\": \\\"1-2 Sätze worum es geht\\\", \\\"claims\\\": [\\\"Behauptung 1\\\", \\\"Behauptung 2\\\"]}. Extrahiere maximal 3 zentrale, faktisch prüfbare Behauptungen als prägnante, suchbare englische Aussagen.\" }, { \"role\": \"user\", \"content\": $json.input } ] }}"
            }
          ]
        },
